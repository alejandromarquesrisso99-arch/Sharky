# Entornos virtuales
.venv/
env/
venv/
ENV/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Variables de entorno, secretos y extractos financieros personales. Los CSV
# son el formato de importación de posiciones (`sharky init`): llevan la
# cartera de quien lo usa.
.env
*.pdf
*.csv

# Distribución / Build
dist/
build/
*.egg-info/

# Logs del arranque automático en Windows
logs/

# Backups locales del vault (scripts/backup_vault.ps1): la única copia de
# seguridad de la bóveda, que no se versiona (ver abajo).
backups/

# Bóveda personal. El repositorio es público y Sharky escribe datos de la
# cartera real en casi toda la bóveda (libro de posiciones, estado vital,
# operaciones, diarios, tesis, rebalanceos, noticias), así que se ignora
# entera. Sólo se versiona lo que no contiene ningún dato de la cartera: las
# plantillas y las notas de reglas que `tests/test_vault_sync.py` contrasta
# con `sharky/config.py`. Antes de añadir otra excepción, comprueba que la
# nota no lleve importes, unidades ni posiciones.
/vault/**
!/vault/**/
!/vault/07_Plantillas/*.md
!/vault/00_Sistema/Reglas_De_Supervivencia.md
!/vault/00_Sistema/Metricas_Riesgo.md
!/vault/00_Comite_Direccion/Mandato_Institucional.md
!/vault/03_Mesa_Cuantitativa_Riesgo/Politica_Control_Riesgo.md

# Archivos de sistema y editores
.DS_Store
Thumbs.db
.vscode/
.idea/

# Obsidian cache / workspace local (preservando notas)
vault/.obsidian/workspace*
vault/.obsidian/cache/
