# ===================================================
# SHARKY CAPITAL MANAGEMENT — CONFIGURACIÓN DE ENTORNO
# ===================================================
# Copia este archivo a `.env` y rellena tus valores.
# Todas las variables son opcionales: los valores por defecto están en
# `sharky/config.py` y replican los axiomas de
# `vault/00_Sistema/Reglas_De_Supervivencia.md`.

# ---------------------------------------------------
# 1. Inteligencia artificial (Claude / Anthropic)
# ---------------------------------------------------
# Consíguela en https://console.anthropic.com/settings/keys
# Sin ella, Sharky sigue funcionando: calcula NAV, riesgo y rebalanceo de forma
# determinista, pero los informes salen marcados como "simulados".
ANTHROPIC_API_KEY=tu_api_key_aqui

# Modelos disponibles (familia Claude 5):
#   claude-opus-5    → máxima capacidad de razonamiento para el rol de CIO
#   claude-sonnet-5  → equilibrio recomendado entre calidad y coste
#   claude-haiku-4-5-20251001 → el más económico, para pruebas
CLAUDE_MODEL=claude-sonnet-5

# Si es false, un fallo de la API interrumpe la ejecución en lugar de generar
# prosa de plantilla. Útil si prefieres no tener informes simulados.
SHARKY_ALLOW_SIMULATED_INTELLIGENCE=true

# Perfiles de razonamiento por cadencia. `effort` (low/medium/high/xhigh/max)
# controla cuánto piensa el modelo; `max_tokens` es el techo de seguridad
# (pensamiento + texto). Si el log muestra stop_reason='max_tokens' sin texto,
# sube el max_tokens de ese perfil o baja su effort. Effort vacío = no se envía
# (para modelos que no lo admiten).
#   Diario  : posiciones, precios, valor de mercado y normas.
#   Semanal : noticias + contexto de los últimos 7 controles diarios.
#   Mensual : estudio completo y reevaluación de posiciones (usa streaming).
# SHARKY_MAX_TOKENS_DIARIO=8000
# SHARKY_EFFORT_DIARIO=low
# SHARKY_MAX_TOKENS_MENSUAL=32000
# SHARKY_EFFORT_MENSUAL=high
# SHARKY_MAX_TOKENS_COMITE=16000              # `sharky committee`, a demanda (effort mensual)
# SHARKY_UMBRAL_MOVIMIENTO_PCT=7              # variación diaria que marca una posición "a vigilar"

# Escaneo semanal de noticias de los activos en cartera (usa la tool de
# búsqueda web de la API de Claude). Sin ANTHROPIC_API_KEY no se ejecuta: no
# existe un "modo simulado" con sentido para noticias reales.
# SHARKY_NEWS_MODEL=claude-sonnet-5           # por defecto, el mismo que CLAUDE_MODEL
# SHARKY_NEWS_SCAN_WEEKDAY=6                  # 0=lunes ... 6=domingo (por defecto)
# SHARKY_NEWS_MAX_BUSQUEDAS_POR_ACTIVO=3
# SHARKY_NEWS_MAX_BUSQUEDAS_TOTAL=30          # techo absoluto, no escala sin límite con la cartera
# SHARKY_NEWS_MAX_TOKENS_INFORME=16000
# SHARKY_NEWS_EFFORT=medium

# ---------------------------------------------------
# 2. Cartera y ejecución
# ---------------------------------------------------
# Divisa base: EUR, fija (no configurable). La cartera de Trade Republic está
# denominada en EUR y las tablas de cambio de emergencia de `sharky.fx` están
# tabuladas contra EUR; no hay variable de entorno que la cambie.

# Sharky no tiene modo simulación: NUNCA envía órdenes a un broker, sólo
# propone y registra lo que ya ejecutaste en Trade Republic. Toda entrada
# de `sharky trade` es una compra o venta real sobre Cartera_Real.md.

# Ruta de la bóveda de Obsidian (por defecto: ./vault)
# SHARKY_VAULT_PATH=C:/ruta/a/tu/vault

# El capital y las posiciones NO se configuran aquí: la fuente de verdad es
# `vault/00_Sistema/Cartera_Real.md`.

# ---------------------------------------------------
# 3. Límites de riesgo (Reglas_De_Supervivencia.md)
# ---------------------------------------------------
# Descomenta sólo si quieres desviarte del mandato escrito en la bóveda.
# SHARKY_MAX_POS_PCT=10.0          # máximo por activo
# SHARKY_MAX_POS_ALERTA_PCT=5.0    # máximo por activo en estado ALERTA
# SHARKY_MAX_SECTOR_PCT=25.0       # máximo por sector
# SHARKY_MIN_CASH_PCT=15.0         # liquidez mínima
# SHARKY_MAX_CASH_PCT=30.0         # liquidez máxima
# SHARKY_MAX_RISK_PCT=1.5          # riesgo máximo por operación
# SHARKY_MIN_RR_RATIO=2.0          # ratio riesgo/beneficio mínimo

# Vigilancia de niveles (sharky niveles / ciclo diario). Al alcanzar el target,
# Sharky propone subir el stop al mayor de: el precio de entrada (break-even) o
# el precio actual menos el riesgo inicial de la tesis (trailing). Este
# porcentaje es sólo el trailing de reserva para tesis sin entrada o sin stop
# declarados. El take-profit NUNCA obliga a vender: el stop sí obliga.
# SHARKY_TRAILING_STOP_PCT=8.0

# Dónde deja el ciclo los niveles alcanzados para el aviso emergente de Windows
# (scripts/avisar_niveles_windows.ps1). Por defecto logs/alertas_niveles.json,
# fuera de git: contiene posiciones y valores reales de la cartera.
# SHARKY_ALERTAS_NIVELES_PATH=logs/alertas_niveles.json

# Umbrales de estado vital, medidos como drawdown desde el máximo histórico.
# Cuidados Intensivos cubre de SHARKY_DD_ALERTA_PCT a SHARKY_DEATH_DRAWDOWN_PCT
# de un tirón: no hay un tercer umbral intermedio que configurar.
# SHARKY_DD_OPTIMO_PCT=3.0
# SHARKY_DD_ALERTA_PCT=8.0
# SHARKY_DEATH_DRAWDOWN_PCT=20.0

# Días que un incumplimiento del mandato puede seguir abierto en Estado_Vital.md
# antes de marcarse como ESCALADO (ver auditoría de 2026-09).
# SHARKY_BREACH_ESCALATION_DAYS=7

# Cuántos días de controles diarios (conclusiones del frontmatter de
# 05_Diario_Reflexion) relee cada nivel: el escaneo semanal de noticias y el
# estudio mensual (que además lee los escaneos semanales de ese periodo).
# SHARKY_DIAS_CONTEXTO_SEMANAL=7
# SHARKY_DIAS_CONTEXTO_MENSUAL=31

# ---------------------------------------------------
# 4. Datos de mercado
# ---------------------------------------------------
# Segundos de validez de una cotización en caché (evita castigar la API en el
# servicio 24/7).
# SHARKY_PRICE_CACHE_TTL=900
