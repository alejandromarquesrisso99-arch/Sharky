# ===================================================
# SHARKY CAPITAL MANAGEMENT — CONFIGURACIÓN DE ENTORNO
# ===================================================
# Copia este archivo a `.env` y rellena tus valores.
# Todas las variables son opcionales: los valores por defecto están en
# `sharky/config.py` y replican los axiomas de
# `vault/00_Sistema/Reglas_De_Supervivencia.md`.

# ---------------------------------------------------
# 1. Inteligencia artificial (Claude / Anthropic)
# ---------------------------------------------------
# Consíguela en https://console.anthropic.com/settings/keys
# Sin ella, Sharky sigue funcionando: calcula NAV, riesgo y rebalanceo de forma
# determinista, pero los informes salen marcados como "simulados".
ANTHROPIC_API_KEY=tu_api_key_aqui

# Modelos disponibles (familia Claude 5):
#   claude-opus-5    → máxima capacidad de razonamiento para el rol de CIO
#   claude-sonnet-5  → equilibrio recomendado entre calidad y coste
#   claude-haiku-4-5-20251001 → el más económico, para pruebas
CLAUDE_MODEL=claude-sonnet-5

# Si es false, un fallo de la API interrumpe la ejecución en lugar de generar
# prosa de plantilla. Útil si prefieres no tener informes simulados.
SHARKY_ALLOW_SIMULATED_INTELLIGENCE=true

# Presupuesto de tokens de cada informe. Si el log muestra
# stop_reason='max_tokens' sin texto (el modelo gasta el presupuesto en
# razonamiento antes de emitir texto visible), sube este valor.
# SHARKY_MAX_TOKENS_INFORME=2000

# ---------------------------------------------------
# 2. Cartera y ejecución
# ---------------------------------------------------
# Divisa base. La cartera de Trade Republic está denominada en EUR.
SHARKY_BASE_CURRENCY=EUR

# PAPER : las operaciones registradas se marcan como simuladas.
# REAL  : reflejan ejecuciones hechas realmente en el broker.
# En ambos casos Sharky NUNCA envía órdenes: sólo propone y registra.
SHARKY_EXECUTION_MODE=PAPER

# Ruta de la bóveda de Obsidian (por defecto: ./vault)
# SHARKY_VAULT_PATH=C:/ruta/a/tu/vault

# El capital y las posiciones NO se configuran aquí: la fuente de verdad es
# `vault/00_Sistema/Cartera_Real.md`.

# ---------------------------------------------------
# 3. Límites de riesgo (Reglas_De_Supervivencia.md)
# ---------------------------------------------------
# Descomenta sólo si quieres desviarte del mandato escrito en la bóveda.
# SHARKY_MAX_POS_PCT=10.0          # máximo por activo
# SHARKY_MAX_POS_ALERTA_PCT=5.0    # máximo por activo en estado ALERTA
# SHARKY_MAX_SECTOR_PCT=25.0       # máximo por sector
# SHARKY_MIN_CASH_PCT=15.0         # liquidez mínima
# SHARKY_MAX_CASH_PCT=30.0         # liquidez máxima
# SHARKY_MAX_RISK_PCT=1.5          # riesgo máximo por operación
# SHARKY_MIN_RR_RATIO=2.0          # ratio riesgo/beneficio mínimo

# Umbrales de estado vital, medidos como drawdown desde el máximo histórico.
# Cuidados Intensivos cubre de SHARKY_DD_ALERTA_PCT a SHARKY_DEATH_DRAWDOWN_PCT
# de un tirón: no hay un tercer umbral intermedio que configurar.
# SHARKY_DD_OPTIMO_PCT=3.0
# SHARKY_DD_ALERTA_PCT=8.0
# SHARKY_DEATH_DRAWDOWN_PCT=20.0

# Días que un incumplimiento del mandato puede seguir abierto en Estado_Vital.md
# antes de marcarse como ESCALADO (ver auditoría de 2026-09).
# SHARKY_BREACH_ESCALATION_DAYS=7

# Cuánto diario reciente (frontmatter de 05_Diario_Reflexion) se relee como
# memoria antes de cada informe de IA. El día 1 usa el mensual (cierra el
# ciclo del mes); el resto de días usa el diario (semana reciente).
# SHARKY_DIAS_CONTEXTO_DIARIO=7
# SHARKY_DIAS_CONTEXTO_MENSUAL=30

# ---------------------------------------------------
# 4. Datos de mercado
# ---------------------------------------------------
# Segundos de validez de una cotización en caché (evita castigar la API en el
# servicio 24/7).
# SHARKY_PRICE_CACHE_TTL=900
