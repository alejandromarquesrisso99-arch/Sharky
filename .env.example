# ==========================================
# CONFIGURACIÓN DE SHARKY (CEREBRO DIGITAL)
# ==========================================

# Clave de API de Anthropic Claude (Obtén la tuya en https://console.anthropic.com)
# Si se deja vacía, Sharky funcionará en MODO SIMULACIÓN sin fallar.
ANTHROPIC_API_KEY=TU_ANTHROPIC_API_KEY_AQUI

# Modelo de Claude a utilizar
CLAUDE_MODEL=claude-3-7-sonnet-20250219

# Ruta personalizada a la bóveda de Obsidian (por defecto utiliza ./vault)
# SHARKY_VAULT_PATH=C:/Users/tu_usuario/Mi_Boveda_Inversiones

# Parámetros Financieros Iniciales
SHARKY_INITIAL_CAPITAL=10000.00
SHARKY_MAX_POS_PCT=10.0
SHARKY_MAX_RISK_PCT=1.5
SHARKY_MIN_RR_RATIO=2.0
SHARKY_DEATH_DRAWDOWN_PCT=20.0

# Modo de Ejecución: "PAPER" (Simulado) o "REAL"
SHARKY_EXECUTION_MODE=PAPER
